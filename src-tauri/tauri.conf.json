{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "docker-lite",
  "version": "0.2.0",
  "identifier": "com.nipun.docker-lite",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Docker Lite - Container Studio",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "maximized": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Ultra-fast, lightweight container management studio for Docker.",
    "longDescription": "Docker Lite is an ultra-fast, modern container management studio and dashboard for Docker, providing real-time telemetry, container orchestration, volume/network management, and instant developer stacks.",
    "copyright": "Copyright © 2026 Docker Lite",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "entitlements": null
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libappindicator3-1",
          "librsvg2-common"
        ],
        "section": "devel"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
